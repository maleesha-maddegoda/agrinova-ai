# ==============================================================================
# AgriNova AI - Backend Environment Configuration Template
# Copy this file to .env in the backend directory:
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows CMD)
# ==============================================================================

# ── Supabase Configuration ────────────────────────────────────────────────────
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-secret-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
STORAGE_BUCKET=crop-images

# ── AI Disease Classifier (EfficientNet-B0) ───────────────────────────────────
# Path to local PyTorch weights (.pth). If absent and DEV_MODE=true, classifier runs in mock mode.
MODEL_PATH=./models/plant_disease_efficientnet.pth
DEV_MODE=false

# ── LLM & Advisory Engine (Google Gemini / OpenAI compatible) ─────────────────
# Primary key for multilingual farmer guidance & officer AI copilot
GEMINI_API_KEY=your-google-gemini-api-key
LLM_API_KEY=your-gemini-or-openai-api-key
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Weather Risk Assessment (Open-Meteo API) ─────────────────────────────────
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# ── Regional Disease Outbreak Surveillance ───────────────────────────────────
# Radius in kilometers to cluster disease reports
OUTBREAK_RADIUS_KM=25
# Minimum number of matching reports to trigger an outbreak alert
OUTBREAK_MIN_REPORTS=3
# Time window in days for outbreak clustering
OUTBREAK_WINDOW_DAYS=14
# Sensitivity thresholds (1 report = MEDIUM risk, 3 reports = HIGH risk)
OUTBREAK_MEDIUM_THRESHOLD=1
OUTBREAK_HIGH_THRESHOLD=3

# ── Server & CORS Settings ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PORT=8000
