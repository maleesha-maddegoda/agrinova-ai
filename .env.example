# ==============================================================================
# AgriNova AI - Root Environment Reference Template
# ==============================================================================
# AgriNova AI operates with two primary sub-services:
#   1. backend/  (FastAPI + PyTorch + LLM Advisory)
#   2. frontend/ (React 19 + Vite + Tailwind CSS + Leaflet)
#
# Follow these steps to configure each subproject:
#
# 1. Backend Configuration:
#    cd backend
#    copy .env.example .env     # Windows
#    cp .env.example .env       # macOS/Linux
#    (Fill in your SUPABASE_URL, GEMINI_API_KEY, etc.)
#
# 2. Frontend Configuration:
#    cd frontend
#    copy .env.example .env     # Windows
#    cp .env.example .env       # macOS/Linux
#    (Points to VITE_API_URL=http://localhost:8000)
# ==============================================================================

# ── Summary of Core Variables ─────────────────────────────────────────────────
# Backend:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
GEMINI_API_KEY=your-gemini-api-key
PORT=8000

# Frontend:
VITE_API_URL=http://localhost:8000
